# ──────────────────────────────────────────────────────────────────────────────
# karaoke-browser — environment configuration
# Copy this file to .env and fill in the values you need.
# Only YOUTUBE_API_KEYS is required (for search); everything else has a default.
# ──────────────────────────────────────────────────────────────────────────────

# ── YouTube API ───────────────────────────────────────────────────────────────
# Comma-separated list of YouTube Data API v3 keys.
# Keys are used round-robin and automatically retired when their daily quota is
# exceeded (HTTP 403). They revive at midnight UTC when Google resets quotas.
# Get keys at: https://console.cloud.google.com/ → YouTube Data API v3
YOUTUBE_API_KEYS=your_key_here,optional_second_key

# Search result cache TTL in minutes. Identical queries within this window are
# served from cache without consuming any API quota (default 60 minutes).
# SEARCH_CACHE_TTL_MIN=60

# ── Server ────────────────────────────────────────────────────────────────────
# HTTP port (default 3444).
PORT=3444

# Log verbosity: error | warn | info (default) | debug
# LOG_LEVEL=info

# Redis connection URL (required for multi-instance deployments; works fine
# with a local Redis for single-instance use too).
# Default: redis://127.0.0.1:6379
# REDIS_URL=redis://127.0.0.1:6379

# ── Auth (optional) ───────────────────────────────────────────────────────────
# Password-protect the controller and player pages. When set, visitors are shown
# a login form on the index page. The browser hashes the password with SHA-256
# before sending it — the plaintext never leaves the browser.
# Leave commented out for local / LAN use.#
# Preferred: store only the SHA-256 hash so the plaintext password never lives
# in .env. Generate the hash once, then paste the output here:
#
#   npm run hash-password -- yourpassword
#
# AUTH_TOKEN_HASH=<64-char hex from the command above>
#
# Legacy (still accepted, logs a startup warning):# AUTH_TOKEN=change_me_to_something_secret

# ── Sessions ──────────────────────────────────────────────────────────────────
# Maximum concurrent sessions (counted in Redis). Returns HTTP 503 when full.
# MAX_SESSIONS=500

# Hours of WebSocket inactivity before a session is eligible for cleanup and
# excluded from the next disk save.
# SESSION_TTL_HOURS=4

# ── Rate limits ───────────────────────────────────────────────────────────────
# All limits are per IP address unless noted. _MAX = ceiling within the window;
# _WINDOW_MIN = window length in minutes.

# Session creation.
# SESSION_RATE_MAX=10
# SESSION_RATE_WINDOW_MIN=15

# YouTube search endpoint.
# SEARCH_RATE_MAX=20
# SEARCH_RATE_WINDOW_MIN=10

# /api/title (YouTube URL → title resolution).
# TITLE_RATE_MAX=30
# TITLE_RATE_WINDOW_MIN=1

# /api/qr (QR code generation).
# QR_RATE_MAX=20
# QR_RATE_WINDOW_MIN=1

# Login attempts (per IP). Defaults to 5 per 15 minutes.
# LOGIN_RATE_MAX=5
# LOGIN_RATE_WINDOW_MIN=15

# WebSocket connection rate limit (upgrade requests per IP per window).
# Default 60/min — enough for a large party all scanning the QR code at once
# from the same NAT IP. Raise for very large venues.
# WS_CONN_RATE_MAX=60
# WS_CONN_RATE_WINDOW_MIN=1

# Audience song request limits (WebSocket, per-client).
# MAX_SESSION_REQUESTS caps how many pending requests the server holds per
# session inbox before silently dropping new ones.
# WS_REQ_RATE_MAX / WS_REQ_RATE_WINDOW_MIN control how many request messages
# a single WebSocket client may send within the window before being
# disconnected with code 4029.
# MAX_SESSION_REQUESTS=100
# WS_REQ_RATE_MAX=10
# WS_REQ_RATE_WINDOW_MIN=1
