# Get a free API key at https://console.cloud.google.com/
# Enable the "YouTube Data API v3" then create an API key.
# Search won't work without this, but you can still paste YouTube URLs directly.
YOUTUBE_API_KEY=your_api_key_here

# Optional: override the default port (3444)
PORT=3444

# Optional: password-protect the controller and player pages.
# When set, visitors are shown a login form on the index page. The browser
# hashes the password with SHA-256 before sending it — the plaintext never
# leaves the browser. Leave blank or commented out for local/LAN use.
# AUTH_TOKEN=change_me_to_something_secret

# Log verbosity: error | warn | info (default) | debug
# LOG_LEVEL=info
