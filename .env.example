# Get a free API key at https://console.cloud.google.com/
# Enable the "YouTube Data API v3" then create an API key
YOUTUBE_API_KEY=your_api_key_here

# Optional: override the default port (3444)
PORT=3444

# Auth token for public access (e.g. via reverse proxy).
# Leave commented out / blank to disable auth for local/LAN use.
# First visit: open the URL with ?token=<your_token> — sets a session cookie
# so OBS and the controller stay authenticated automatically after that.
AUTH_TOKEN=change_me_to_something_secret
